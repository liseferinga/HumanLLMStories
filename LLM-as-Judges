    "ax.set_ylabel(\"Average pass rate (%)\")\n",
    "ax.set_ylim(0, 110)\n",
    "ax.set_title(\n",
    "    \"LLM-assessor models\\n(bars = mean across items; whiskers = min–max across items)\",\n",
    "    fontsize=11, fontweight=\"bold\", loc=\"left\"\n",
    ")\n",
